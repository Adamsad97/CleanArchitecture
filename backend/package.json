{
  "name": "ecoeats-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:backend": "npm run dev:express",
    "dev:express": "tsx watch src/main/express.ts",
    "dev:fastify": "tsx watch src/main/fastify.ts",
    "build": "tsc -p tsconfig.json",
    "start:express": "node dist/main/express.js",
    "start:fastify": "node dist/main/fastify.js",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.2.1",
    "sql.js": "^1.13.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/sql.js": "^1.4.9",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
}
